# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Description: Template file showing required environment variables.
# Copy this file to '.env' and fill in your actual private credentials.
# ==============================================================================

# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# Project: Premium Backend API (Version 2 - Parallel Environment)
# Architecture: Clean Configuration & Twelve-Factor App Methodology
# SECURITY WARNING: Never commit this file to version control (Git). Keep it private.
# ==============================================================================

# --- GENERAL PROJECT METADATA ---
PROJECT_NAME="Premium Backend API (v2)"

# --- DATABASE CONNECTION PARAMETERS (Docker Port Mapping) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433               # External port on your host machine (mapped from Docker -p 5433:5432)
POSTGRES_CONTAINER_PORT=5432     # Internal port where PostgreSQL runs inside the container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=backend_db_v2

# --- SECURITY & JWT AUTHENTICATION ---
# Secret cryptographic key used to sign and verify JSON Web Tokens (JWT) generated via 'secrets.token_urlsafe(32)'.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="generate_a_secure_random_key_here"

# Cryptographic algorithm used for token encryption.
ALGORITHM="HS256"

# Token expiration lifetime in minutes before requiring re-authentication.
ACCESS_TOKEN_EXPIRE_MINUTES=30